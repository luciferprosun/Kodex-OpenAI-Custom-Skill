{
  "schema_version": "0.2",
  "triggers": [
    {
      "group": "secrets_keys",
      "terms": [
        "secret",
        "api key",
        "token",
        "private key",
        ".env",
        "credential",
        "(?:~?/)?\\.ssh/(?:id_rsa|id_ed25519|id_ecdsa|id_dsa)\\b",
        "(?:~?/)?\\.codex/auth\\.json\\b",
        "\\b(?:credential|token)\\s+stores?\\b",
        "\\b(?:cat|read|print|copy|cp|export|upload|modify|edit|write|move|mv)\\b.*\\.(?:pem|key)\\b",
        "\\.(?:pem|key)\\b.*\\bprivate\\s+keys?\\b",
        "-----BEGIN.*PRIVATE KEY-----"
      ],
      "risk": "critical",
      "category": "secret_handling",
      "profile": "security",
      "sandbox": "read-only",
      "approval": "on-request",
      "action_danger": "secret_touching_operation",
      "execute_by_default": false,
      "confirmation_required": true,
      "reason": "direct credential exposure risk"
    },
    {
      "group": "auth_identity",
