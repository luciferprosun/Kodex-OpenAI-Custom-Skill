{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-router.invalid/schemas/local_codex_run.schema.json",
  "title": "SmartRouter privacy-safe local Codex run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "run_id",
    "session_id",
    "started_at",
    "finished_at",
    "wall_time_ms",
    "router_version",
    "router_decision_id",
    "task_signature",
    "task_domain",
    "task_subdomain",
    "task_difficulty",
    "task_scope",
    "task_risk",
    "verification_available",
    "requested_model",
    "recommended_model",
    "launched_model",
    "backend_model",
    "model_identity_status",
    "reasoning_effort",
    "agent_count",
    "sandbox",
    "approval_policy",
    "input_tokens",
    "non_cached_input_tokens",
    "cached_input_tokens",
    "reasoning_tokens",
    "visible_output_tokens",
    "total_reported_tokens",
    "request_count",
    "tool_call_count",
    "tool_calls_by_type",
    "invalid_tool_call_count",
    "retry_count",
    "escalation_count",
    "compaction_count",
    "verifier_type",
    "verifier_result",
    "tests_passed",
    "tests_failed",
    "operator_outcome",
    "operator_outcome_at",
    "measurement_sources",
    "missing_fields",
    "privacy_classification",
    "product_surface",
    "counter_reconciliation",
    "duplicate_event_count",
    "invalid_event_count",
    "collector_status",
    "process_exit_code",
    "record_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "run"},
    "run_id": {"type": "string", "format": "uuid"},
    "session_id": {"$ref": "#/$defs/nullableHash"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "wall_time_ms": {"$ref": "#/$defs/nonnegativeInteger"},
    "router_version": {"$ref": "#/$defs/safeString"},
    "router_decision_id": {"type": "string", "format": "uuid"},
    "task_signature": {"$ref": "#/$defs/hash"},
    "task_domain": {"$ref": "#/$defs/safeString"},
    "task_subdomain": {"$ref": "#/$defs/nullableSafeString"},
    "task_difficulty": {"enum": ["low", "medium", "high", "unknown"]},
    "task_scope": {"enum": ["none", "local", "remote", "network", "system", "repo", "module", "single_file", "unknown"]},
    "task_risk": {"enum": ["low", "medium", "high", "critical", "unknown"]},
    "verification_available": {"type": ["boolean", "null"]},
    "requested_model": {"$ref": "#/$defs/nullableSafeString"},
    "recommended_model": {"$ref": "#/$defs/nullableSafeString"},
    "launched_model": {"$ref": "#/$defs/nullableSafeString"},
    "backend_model": {"$ref": "#/$defs/nullableSafeString"},
    "model_identity_status": {"enum": ["provider_reported", "service_reported", "client_requested_only", "inferred_alias", "unknown"]},
    "reasoning_effort": {"$ref": "#/$defs/nullableSafeString"},
    "agent_count": {"$ref": "#/$defs/nullableNonnegativeInteger"},
    "sandbox": {"$ref": "#/$defs/safeString"},
    "approval_policy": {"$ref": "#/$defs/safeString"},
    "input_tokens": {"$ref": "#/$defs/nullableNonnegativeInteger"},
    "non_cached_input_tokens": {"$ref": "#/$defs/nullableNonnegativeInteger"},
    "cached_input_tokens": {"$ref": "#/$defs/nullableNonnegativeInteger"},
    "reasoning_tokens": {"$ref": "#/$defs/nullableNonnegativeInteger"},
    "visible_output_tokens": {"$ref": "#/$defs/nullableNonnegativeInteger"},
    "total_reported_tokens": {"$ref": "#/$defs/nullableNonnegativeInteger"},
    "request_count": {"$ref": "#/$defs/nullableNonnegativeInteger"},
    "tool_call_count": {"$ref": "#/$defs/nullableNonnegativeInteger"},
    "tool_calls_by_type": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+@-]{0,159}$"},
          "additionalProperties": {"type": "integer", "minimum": 1}
        }
      ]
    },
    "invalid_tool_call_count": {"$ref": "#/$defs/nullableNonnegativeInteger"},
    "retry_count": {"$ref": "#/$defs/nullableNonnegativeInteger"},
    "escalation_count": {"$ref": "#/$defs/nullableNonnegativeInteger"},
    "compaction_count": {"$ref": "#/$defs/nullableNonnegativeInteger"},
    "verifier_type": {"$ref": "#/$defs/nullableSafeString"},
    "verifier_result": {"$ref": "#/$defs/nullableSafeString"},
    "tests_passed": {"$ref": "#/$defs/nullableNonnegativeInteger"},
    "tests_failed": {"$ref": "#/$defs/nullableNonnegativeInteger"},
    "operator_outcome": {"type": "null"},
    "operator_outcome_at": {"type": "null"},
    "measurement_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_count", "backend_model", "cached_input_tokens", "compaction_count",
        "escalation_count", "input_tokens", "invalid_tool_call_count", "launched_model",
        "non_cached_input_tokens", "reasoning_effort", "reasoning_tokens", "recommended_model",
        "request_count", "requested_model", "retry_count", "tests_failed", "tests_passed",
        "tool_call_count", "total_reported_tokens", "verifier_result", "visible_output_tokens",
        "wall_time_ms"
      ],
      "properties": {
        "agent_count": {"$ref": "#/$defs/measurementStatus"},
        "backend_model": {"$ref": "#/$defs/measurementStatus"},
        "cached_input_tokens": {"$ref": "#/$defs/measurementStatus"},
        "compaction_count": {"$ref": "#/$defs/measurementStatus"},
        "escalation_count": {"$ref": "#/$defs/measurementStatus"},
        "input_tokens": {"$ref": "#/$defs/measurementStatus"},
        "invalid_tool_call_count": {"$ref": "#/$defs/measurementStatus"},
        "launched_model": {"$ref": "#/$defs/measurementStatus"},
        "non_cached_input_tokens": {"$ref": "#/$defs/measurementStatus"},
        "reasoning_effort": {"$ref": "#/$defs/measurementStatus"},
        "reasoning_tokens": {"$ref": "#/$defs/measurementStatus"},
        "recommended_model": {"$ref": "#/$defs/measurementStatus"},
        "request_count": {"$ref": "#/$defs/measurementStatus"},
        "requested_model": {"$ref": "#/$defs/measurementStatus"},
        "retry_count": {"$ref": "#/$defs/measurementStatus"},
        "tests_failed": {"$ref": "#/$defs/measurementStatus"},
        "tests_passed": {"$ref": "#/$defs/measurementStatus"},
        "tool_call_count": {"$ref": "#/$defs/measurementStatus"},
        "total_reported_tokens": {"$ref": "#/$defs/measurementStatus"},
        "verifier_result": {"$ref": "#/$defs/measurementStatus"},
        "visible_output_tokens": {"$ref": "#/$defs/measurementStatus"},
        "wall_time_ms": {"$ref": "#/$defs/measurementStatus"}
      }
    },
    "missing_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "privacy_classification": {"const": "metadata_only_hmac"},
    "product_surface": {"$ref": "#/$defs/safeString"},
    "counter_reconciliation": {"enum": ["per_request_sum", "final_cumulative_snapshot", "mixed_reconciled", "unknown"]},
    "duplicate_event_count": {"$ref": "#/$defs/nonnegativeInteger"},
    "invalid_event_count": {"$ref": "#/$defs/nonnegativeInteger"},
    "collector_status": {"enum": ["completed", "completed_with_invalid_events", "process_error", "aborted", "collector_interrupted", "partial_unreconciled"]},
    "process_exit_code": {"type": ["integer", "null"]},
    "record_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullableHash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "safeString": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+@-]{0,159}$"},
    "nullableSafeString": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+@-]{0,159}$"},
    "nonnegativeInteger": {"type": "integer", "minimum": 0},
    "nullableNonnegativeInteger": {"type": ["integer", "null"], "minimum": 0},
    "measurementStatus": {"enum": ["measured", "provider_reported", "client_reported", "reconstructed", "unknown"]}
  }
}
