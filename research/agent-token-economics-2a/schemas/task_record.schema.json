{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-router.local/schemas/task_record.schema.json",
  "title": "SmartRouter Token Economics Task Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version",
    "source_id",
    "dataset_id",
    "benchmark_id",
    "benchmark_version",
    "task_id",
    "task_domain",
    "task_subdomain",
    "task_difficulty",
    "se_level",
    "math_level",
    "phy_level",
    "interaction_mode",
    "file_scope",
    "repository_scope",
    "mutation_mode",
    "tool_profile",
    "verifier_profile",
    "horizon",
    "requirement_clarity",
    "context_state",
    "risk_level",
    "work_type",
    "task_size",
    "repository_size",
    "success_criterion",
    "missing_fields",
    "provenance"
  ],
  "properties": {
    "record_version": { "const": "2a.1" },
    "source_id": { "type": "string" },
    "dataset_id": { "type": "string" },
    "benchmark_id": { "type": ["string", "null"] },
    "benchmark_version": { "type": ["string", "null"] },
    "task_id": { "type": "string" },
    "task_domain": {
      "enum": ["SE", "MATH", "PHY", "WEB", "COMPUTER_USE", "RESEARCH", "OTHER"]
    },
    "task_subdomain": { "type": ["string", "null"] },
    "task_difficulty": { "type": ["string", "number", "null"] },
    "se_level": { "type": ["integer", "null"], "minimum": 0, "maximum": 9 },
    "math_level": { "type": ["integer", "null"], "minimum": 0, "maximum": 9 },
    "phy_level": { "type": ["integer", "null"], "minimum": 0, "maximum": 9 },
    "interaction_mode": { "enum": ["single_turn", "agentic", "unknown"] },
    "file_scope": { "enum": ["none", "single_file", "multi_file", "unknown"] },
    "repository_scope": { "enum": ["none", "repository_local", "cross_repository", "unknown"] },
    "mutation_mode": { "enum": ["read_only", "write", "mixed", "unknown"] },
    "tool_profile": { "enum": ["tool_free", "light", "tool_heavy", "unknown"] },
    "verifier_profile": { "enum": ["deterministic", "partial", "subjective", "none", "unknown"] },
    "horizon": { "enum": ["short", "medium", "long", "unknown"] },
    "requirement_clarity": { "enum": ["clear", "partially_ambiguous", "ambiguous", "unknown"] },
    "context_state": { "enum": ["fresh", "continued", "long_continuing", "unknown"] },
    "risk_level": { "enum": ["low", "moderate", "high_impact", "unknown"] },
    "work_type": { "enum": ["research", "implementation", "analysis", "verification", "mixed", "unknown"] },
    "task_size": { "type": ["number", "null"], "minimum": 0 },
    "repository_size": { "type": ["number", "null"], "minimum": 0 },
    "success_criterion": { "type": ["string", "null"] },
    "missing_fields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "provenance": { "$ref": "source_provenance.schema.json" }
  }
}
