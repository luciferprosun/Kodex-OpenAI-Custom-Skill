{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-router.local/schemas/agent_run_record.schema.json",
  "title": "SmartRouter Token Economics Canonical Agent Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version", "source_id", "dataset_id", "run_id", "task_id",
    "timestamp", "model_id", "model_alias", "model_version",
    "model_provider", "product_surface", "agent_framework", "agent_version",
    "agent_count", "reasoning_effort", "task_domain", "task_subdomain",
    "task_difficulty", "task_size", "repository_size", "files_touched",
    "prompt_tokens", "non_cached_input_tokens", "cached_input_tokens",
    "cache_write_tokens", "reasoning_tokens", "visible_output_tokens", "total_reported_tokens",
    "prompt_tokens_scope", "total_reported_tokens_scope",
    "cumulative_session_tokens", "current_context_occupancy",
    "tokens_resent_from_history", "tokens_from_tool_output",
    "tokens_from_compaction", "api_billed_tokens", "subscription_quota_units",
    "number_of_model_requests", "number_of_tool_calls", "tool_calls_by_type",
    "invalid_tool_calls", "repeated_tool_calls", "context_window",
    "peak_context_used", "context_compactions", "retry_count",
    "escalation_count", "wall_time_seconds", "verifier_type",
    "verifier_result", "task_success", "partial_score",
    "human_review_minutes", "reported_cost", "normalized_cost",
    "cost_currency", "reported_cost_scope", "normalized_cost_scope",
    "price_table_date", "price_table_id", "cost_reconstruction_basis",
    "tool_cost", "verification_cost", "human_review_cost", "failure_penalty_cost",
    "attempt_chain_id", "attempt_sequence", "attempt_chain_complete",
    "route_final_accepted", "request_breakdown_complete",
    "trajectory_available", "measurement_method",
    "measurement_confidence", "quality_components", "quality_score", "quality_class",
    "included_in_numerical_priors", "included_in_censoring_analysis", "censored", "censor_reason",
    "missing_fields", "license", "provenance"
  ],
  "properties": {
    "record_version": { "const": "2a.1" },
    "source_id": { "type": "string" },
    "dataset_id": { "type": "string" },
    "run_id": { "type": "string" },
    "task_id": { "type": "string" },
    "timestamp": { "type": ["string", "null"], "format": "date-time" },
    "model_id": { "type": ["string", "null"] },
    "model_alias": { "type": ["string", "null"] },
    "model_version": { "type": ["string", "null"] },
    "model_provider": { "type": ["string", "null"] },
    "product_surface": { "type": ["string", "null"] },
    "agent_framework": { "type": ["string", "null"] },
    "agent_version": { "type": ["string", "null"] },
    "agent_count": { "$ref": "#/$defs/nullableCount" },
    "reasoning_effort": { "type": ["string", "null"] },
    "task_domain": { "enum": ["SE", "MATH", "PHY", "WEB", "COMPUTER_USE", "RESEARCH", "OTHER"] },
    "task_subdomain": { "type": ["string", "null"] },
    "task_difficulty": { "type": ["string", "number", "null"] },
    "task_size": { "type": ["number", "null"], "minimum": 0 },
    "repository_size": { "type": ["number", "null"], "minimum": 0 },
    "files_touched": { "$ref": "#/$defs/nullableCount" },
    "prompt_tokens": { "$ref": "#/$defs/nullableCount" },
    "non_cached_input_tokens": { "$ref": "#/$defs/nullableCount" },
    "cached_input_tokens": { "$ref": "#/$defs/nullableCount" },
    "cache_write_tokens": { "$ref": "#/$defs/nullableCount" },
    "reasoning_tokens": { "$ref": "#/$defs/nullableCount" },
    "visible_output_tokens": { "$ref": "#/$defs/nullableCount" },
    "total_reported_tokens": { "$ref": "#/$defs/nullableCount" },
    "prompt_tokens_scope": { "enum": ["single_request", "per_run_cumulative", "unknown"] },
    "total_reported_tokens_scope": { "enum": ["single_request", "per_run_cumulative", "unknown"] },
    "cumulative_session_tokens": { "$ref": "#/$defs/nullableCount" },
    "current_context_occupancy": { "$ref": "#/$defs/nullableCount" },
    "tokens_resent_from_history": { "$ref": "#/$defs/nullableCount" },
    "tokens_from_tool_output": { "$ref": "#/$defs/nullableCount" },
    "tokens_from_compaction": { "$ref": "#/$defs/nullableCount" },
    "api_billed_tokens": { "$ref": "#/$defs/nullableCount" },
    "subscription_quota_units": { "type": ["number", "null"], "minimum": 0 },
    "number_of_model_requests": { "$ref": "#/$defs/nullableCount" },
    "number_of_tool_calls": { "$ref": "#/$defs/nullableCount" },
    "tool_calls_by_type": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "invalid_tool_calls": { "$ref": "#/$defs/nullableCount" },
    "repeated_tool_calls": { "$ref": "#/$defs/nullableCount" },
    "context_window": { "$ref": "#/$defs/nullableCount" },
    "peak_context_used": { "$ref": "#/$defs/nullableCount" },
    "context_compactions": { "$ref": "#/$defs/nullableCount" },
    "retry_count": { "$ref": "#/$defs/nullableCount" },
    "escalation_count": { "$ref": "#/$defs/nullableCount" },
    "wall_time_seconds": { "type": ["number", "null"], "minimum": 0 },
    "verifier_type": { "type": ["string", "null"] },
    "verifier_result": { "type": ["string", "null"] },
    "task_success": { "type": ["boolean", "null"] },
    "partial_score": { "type": ["number", "null"] },
    "human_review_minutes": { "type": ["number", "null"], "minimum": 0 },
    "reported_cost": { "type": ["number", "null"], "minimum": 0 },
    "normalized_cost": { "type": ["number", "null"], "minimum": 0 },
    "cost_currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
    "reported_cost_scope": { "enum": ["request", "run", "attempt_chain", "subscription", "unknown", null] },
    "normalized_cost_scope": { "enum": ["request", "run", "attempt_chain", "unknown", null] },
    "price_table_date": { "type": ["string", "null"], "format": "date" },
    "price_table_id": { "type": ["string", "null"] },
    "cost_reconstruction_basis": { "type": ["string", "null"] },
    "tool_cost": { "type": ["number", "null"], "minimum": 0 },
    "verification_cost": { "type": ["number", "null"], "minimum": 0 },
    "human_review_cost": { "type": ["number", "null"], "minimum": 0 },
    "failure_penalty_cost": { "type": ["number", "null"], "minimum": 0 },
    "attempt_chain_id": { "type": ["string", "null"] },
    "attempt_sequence": { "$ref": "#/$defs/nullableCount" },
    "attempt_chain_complete": { "type": ["boolean", "null"] },
    "route_final_accepted": { "type": ["boolean", "null"] },
    "request_breakdown_complete": { "type": "boolean" },
    "trajectory_available": { "type": "boolean" },
    "measurement_method": { "$ref": "#/$defs/measurementMap" },
    "measurement_confidence": { "enum": ["high", "medium", "low", "unknown"] },
    "quality_components": { "$ref": "#/$defs/qualityComponents" },
    "quality_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "quality_class": { "enum": ["A", "B", "C", "D", "E"] },
    "included_in_numerical_priors": { "type": "boolean" },
    "included_in_censoring_analysis": { "type": "boolean" },
    "censored": { "type": "boolean" },
    "censor_reason": { "type": ["string", "null"] },
    "missing_fields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "license": { "type": ["string", "null"] },
    "provenance": { "$ref": "source_provenance.schema.json" }
  },
  "$defs": {
    "nullableCount": { "type": ["integer", "null"], "minimum": 0 },
    "measurementMap": {
      "type": "object",
      "additionalProperties": {
        "enum": ["measured", "provider_reported", "framework_reported", "reconstructed", "estimated", "unknown"]
      }
    },
    "qualityComponents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_model_identity", "exact_agent_identity", "exact_task_identity",
        "provider_reported_tokens", "complete_request_breakdown",
        "complete_public_safe_trajectory", "objective_verifier",
        "timestamped_price_table", "repeatable_acquisition", "license_clarity"
      ],
      "properties": {
        "exact_model_identity": { "type": "boolean" },
        "exact_agent_identity": { "type": "boolean" },
        "exact_task_identity": { "type": "boolean" },
        "provider_reported_tokens": { "type": "boolean" },
        "complete_request_breakdown": { "type": "boolean" },
        "complete_public_safe_trajectory": { "type": "boolean" },
        "objective_verifier": { "type": "boolean" },
        "timestamped_price_table": { "type": "boolean" },
        "repeatable_acquisition": { "type": "boolean" },
        "license_clarity": { "type": "boolean" }
      }
    }
  }
}
