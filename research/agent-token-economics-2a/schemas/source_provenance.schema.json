{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-router.local/schemas/source_provenance.schema.json",
  "title": "SmartRouter Token Economics Source Provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version",
    "source_id",
    "dataset_id",
    "canonical_url",
    "artifact_locator",
    "publisher",
    "retrieved_at",
    "license",
    "redistribution_status",
    "commercial_use_status",
    "derived_statistics_status",
    "sha256",
    "transformation",
    "raw_content_committed",
    "hidden_reasoning_removed",
    "privacy_review",
    "notes"
  ],
  "properties": {
    "record_version": { "const": "2a.1" },
    "source_id": { "type": "string", "minLength": 1 },
    "dataset_id": { "type": ["string", "null"] },
    "canonical_url": { "type": "string", "format": "uri" },
    "artifact_locator": { "type": ["string", "null"] },
    "publisher": { "type": "string", "minLength": 1 },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "license": { "type": ["string", "null"] },
    "redistribution_status": {
      "enum": ["allowed", "derived_only", "reference_only", "unknown"]
    },
    "commercial_use_status": {
      "enum": ["allowed", "restricted", "unknown", "not_applicable"]
    },
    "derived_statistics_status": {
      "enum": ["allowed", "restricted", "unknown"]
    },
    "sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "transformation": { "type": "array", "items": { "type": "string" } },
    "raw_content_committed": { "type": "boolean" },
    "hidden_reasoning_removed": { "type": "boolean" },
    "privacy_review": {
      "enum": ["passed", "sanitized", "not_applicable", "pending"]
    },
    "notes": { "type": ["string", "null"] }
  }
}
